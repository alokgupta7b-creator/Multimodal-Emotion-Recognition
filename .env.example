# Multimodal Emotion Recognition — Example Environment Configuration
# Copy to `.env` for local overrides if needed. Never commit real secrets or host credentials.

# --- FastAPI Backend (`api/config.py`) ---
# Inference compute target: auto | cpu | cuda
EMOTION_API_DEVICE=auto

# Active facial emotion backend: resnet18 | legacy_cnn
EMOTION_API_FACIAL_BACKEND=resnet18
EMOTION_API_FACIAL_POOLING=raw_all_detections_mean_prob
EMOTION_API_FACIAL_STRICT_FP32=1

# Locked SHA-256 verification hashes for approved Phase 17 facial checkpoints
EMOTION_API_VIDEO_SHA256=8825d865c70351a38c1da1448d9b6c087a0fe090ad586851edf0342fc4761b64
EMOTION_API_VIDEO_FALLBACK_SHA256=4830ac8409e73da149b4eaf169679f2c2b95322316a411751f0567ac478bc9b0

# Request limits & optimization toggle
EMOTION_API_MAX_UPLOAD_BYTES=52428800
EMOTION_API_MAX_VIDEO_SECONDS=60
EMOTION_API_MAX_TEXT_CHARS=20000
EMOTION_API_OPTIMIZED_VIDEO_PIPELINE=1

# Security & CORS controls
EMOTION_API_ALLOWED_ORIGINS=http://localhost:5173
EMOTION_API_ENABLE_DOCS=1
EMOTION_API_RATE_LIMIT_REQUESTS=120
EMOTION_API_RATE_LIMIT_WINDOW_SECONDS=60

# --- React / Vite Frontend (`frontend/src/api.ts`) ---
VITE_API_BASE_URL=http://localhost:8000

