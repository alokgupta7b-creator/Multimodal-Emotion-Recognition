# Multimodal Emotion Recognition — Staging Environment Template
# Copy to `.env.staging` on your staging host and replace placeholder domains before deployment.
# NEVER commit `.env.staging` or store credentials/secrets inside source files.

# Backend runtime environment
EMOTION_API_ENV=staging
EMOTION_API_HOST=0.0.0.0
EMOTION_API_PORT=8000
EMOTION_API_LOG_LEVEL=INFO
EMOTION_API_DEVICE=cpu
EMOTION_API_ENABLE_DOCS=0
EMOTION_API_FAIL_ON_MISSING_MODELS=1

# Model artifact root and verified ResNet18 checkpoints (V2 primary + V1 focal fallback)
EMOTION_API_MODEL_ROOT=/app/models
EMOTION_API_FACIAL_BACKEND=resnet18
EMOTION_API_FACIAL_POOLING=raw_all_detections_mean_prob
EMOTION_API_FACIAL_STRICT_FP32=1
EMOTION_API_VIDEO_SHA256=1822ba9dc13a7406c13ad4bd48a7c8be7d309ead286cbe40352525bf85c1211a
EMOTION_API_VIDEO_FALLBACK_SHA256=4830ac8409e73da149b4eaf169679f2c2b95322316a411751f0567ac478bc9b0
EMOTION_API_OPTIMIZED_VIDEO_PIPELINE=1

# Strict offline HuggingFace guarantees
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
KMP_DUPLICATE_LIB_OK=TRUE

# Upload, timeout, text length, and sliding-window rate guardrails
EMOTION_API_MAX_UPLOAD_BYTES=52428800
EMOTION_API_MAX_VIDEO_SECONDS=60
EMOTION_API_MAX_TEXT_CHARS=20000
EMOTION_API_REQUEST_TIMEOUT_SECONDS=60
EMOTION_API_RATE_LIMIT_REQUESTS=120
EMOTION_API_RATE_LIMIT_WINDOW_SECONDS=60

# Exact explicit HTTPS origins (wildcard "*" is rejected at startup)
EMOTION_API_ALLOWED_ORIGINS=https://staging.example.invalid

# Frontend Vite build-time API endpoint
VITE_API_BASE_URL=https://api-staging.example.invalid

# Caddy TLS reverse-proxy virtual hostnames (set real hostnames on DNS-enabled staging VPS)
STAGING_DOMAIN=staging.example.invalid
STAGING_API_DOMAIN=api-staging.example.invalid

