# ==============================================================================
# Multimodal Emotion Recognition - Dataset, Media, Feature & Model Exclusions
# ==============================================================================

# Raw media files and archives
*.tar.gz
*.tar
*.zip
*.7z
*.rar
*.mp4
*.avi
*.mkv
*.mov
*.wav
*.mp3
*.flac
*.aac
*.ogg

# Dataset raw media and extracted audio storage
datasets/**/raw/
datasets/**/raw/**
datasets/**/audio/
datasets/**/audio/**
audio/
**/audio/

# MELD Annotation CSVs
datasets/MELD/annotations/*.csv
!datasets/MELD/annotations/.gitkeep

# CMU-MOSEI annotations, raw downloads, and features
datasets/CMU-MOSEI/data/
datasets/CMU-MOSEI/data/**
datasets/CMU-MOSEI/annotations/*.csv
!datasets/CMU-MOSEI/annotations/.gitkeep
datasets/CMU-MOSEI/features/
datasets/CMU-MOSEI/features/**

# Computational Sequence Dataset
*.csd

# Feature extraction arrays and dumps
*.npy
*.npz
*.h5
*.hdf5
*.parquet
*.feather
features/
**/features/

# Model checkpoints and weights
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
models/
**/models/
checkpoints/
**/checkpoints/

# Locally trained text emotion model
text_emotion_model.joblib

# ==============================================================================
# Allow only required probability CSVs for multimodal fusion
# ==============================================================================

# Re-include the parent directories
!features/
!features/fusion/

# Ignore all other generated fusion files
features/fusion/*

# Allow required speech and facial probability files
!features/fusion/speech_dev_probabilities.csv
!features/fusion/speech_test_probabilities.csv
!features/fusion/visual_dev_probabilities.csv
!features/fusion/visual_test_probabilities.csv
