# Multimodal Emotion Recognition — React SPA Frontend (Staging)
FROM node:22-alpine AS builder

WORKDIR /build

# Pass staging API origin at build time (e.g., https://api-staging.example.com or /api behind reverse proxy)
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY frontend/ ./
RUN npm run build

# Unprivileged Nginx runtime stage (non-root UID 101, port 8080)
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

COPY deploy/nginx/security_headers.inc /etc/nginx/security_headers.inc
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /build/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1

