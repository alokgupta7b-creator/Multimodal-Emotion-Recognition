{
  "title": "Multimodal Emotion Studio — Staging Telemetry",
  "uid": "emotion-studio-staging",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "All Models Ready",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "emotion_api_models_ready", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Model Load Duration (ms)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "emotion_api_model_load_duration_ms", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Process RSS (Bytes)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "emotion_api_process_rss_bytes", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Upload Rejections & Cleanup Failures",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "expr": "emotion_api_upload_rejections_total", "refId": "A", "legendFormat": "upload_rejected" },
        { "expr": "emotion_api_cleanup_failures_total", "refId": "B", "legendFormat": "cleanup_failures" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request Rate by Route & Status Class",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (route, status_class) (rate(emotion_api_requests_total[1m]))", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "p95 Inference Latency (seconds)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(emotion_api_request_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    }
  ]
}

